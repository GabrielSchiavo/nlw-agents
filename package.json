{
  "name": "agents-server",
  "version": "1.0.1",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file .env --experimental-strip-types --no-warnings src/server.ts",
    "dev": "node --env-file .env --experimental-strip-types --no-warnings --watch src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file .env --experimental-strip-types --no-warnings src/db/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/node": "25.2.0",
    "drizzle-kit": "^0.31.8",
    "drizzle-seed": "0.3.1",
    "typescript": "5.9.3",
    "ultracite": "7.1.4"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/multipart": "9.4.0",
    "@google/genai": "1.39.0",
    "drizzle-orm": "0.45.1",
    "fastify": "5.7.4",
    "fastify-type-provider-zod": "6.1.0",
    "postgres": "3.4.8",
    "zod": "4.3.6"
  },
  "overrides": {
    "esbuild": "0.25.0"
  }
}
